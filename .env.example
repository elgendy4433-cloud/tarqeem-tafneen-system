# ======================================================================
# متغيرات البيئة لنظام المتابعة | ترقيم & تفنين
# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)
# ======================================================================

# رابط مشروع Supabase (من Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# المفتاح العام الآمن للمتصفح (anon / public key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# بيئة التشغيل
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app

# إعدادات البريد والتنبيهات (اختياري للخادم)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alerts@tarqeem.sa
MAIL_FROM_NAME="نظام المتابعة | ترقيم & تفنين"
